{
  "name": "@iip/agent",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp src/consent.html dist/ && cp -r src/detectors dist/detectors && (cp src/icon.png dist/ 2>/dev/null || true)",
    "dev": "npm run build && electron dist/main.js",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.example.interview-integrity-agent",
    "files": ["dist/**"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  }
}
