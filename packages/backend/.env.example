# MongoDB Atlas connection string (Atlas → Connect → Drivers → copy). Example:
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/interview?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/interview?retryWrites=true&w=majority"
PORT=4000
JWT_SECRET="please-change-this-to-a-long-random-string"
DETECTION_WEBHOOK_SECRET="please-change-this-shared-secret"
CORS_ORIGIN="http://localhost:5173"
