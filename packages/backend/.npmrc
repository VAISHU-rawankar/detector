# The build runs tsc, which needs typescript and every @types/* package — all of
# which live in devDependencies. npm omits those automatically when
# NODE_ENV=production, which is exactly how a host like Render runs the install,
# so the build fails with "TS7016: Could not find a declaration file for module
# 'express'" before it can start.
#
# Forcing it here rather than in the host's build command keeps the fix in the
# repo, where it applies to every environment instead of one dashboard setting.
include=dev
